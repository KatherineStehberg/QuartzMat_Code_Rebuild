# QuartzMat — configuración del servidor
# Copiar a .env local o configurar como variables de entorno en el hosting.
# NUNCA subir valores reales al repositorio.

PORT=4321
NODE_ENV=development
PUBLIC_SITE_URL=http://localhost:4321

# Flow: usar sandbox primero. Producción: https://www.flow.cl/api
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_API_URL=https://sandbox.flow.cl/api

# Precios en pesos chilenos. El servidor calcula el total; el navegador no decide precios.
QUARTZMAT_PRICE=
QUARTZMAT_COVER_PRICE=
QUARTZMAT_KIDS_PRICE=
QUARTZMAT_WEIGHTED_BLANKET_PRICE=

# Datos públicos de contacto. Se pueden completar después.
QUARTZMAT_WHATSAPP=
QUARTZMAT_SHOWROOM_ADDRESS=Av. Las Condes 9036, Las Condes, Región Metropolitana
